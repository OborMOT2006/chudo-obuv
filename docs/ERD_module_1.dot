digraph ERD {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.45, ranksep=1.0, pad=0.4];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
edge [color="#528F8A", arrowsize=0.7, penwidth=1.6, fontname="DejaVu Sans", fontsize=9];
roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>role_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>role_name</B></TD><TD ALIGN="LEFT">VARCHAR(70)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">UQ</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>user_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>last_name</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>first_name</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">VARCHAR(100)</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>middle_name</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>login</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">VARCHAR(100)</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>role_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">FK</FONT></TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>category_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>category_name</B></TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">UQ</FONT></TD></TR></TABLE>>];
manufacturers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>manufacturers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>manufacturer_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>manufacturer_name</B></TD><TD ALIGN="LEFT">VARCHAR(200)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">UQ</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>product_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>manufacturer_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">INTEGER</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>subcategory</B></TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>product_name</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">VARCHAR(255)</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>image_path</B></TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>description</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">TEXT</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>composition</B></TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>price</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">NUMERIC(12,2)</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">-</FONT></TD></TR></TABLE>>];
sizes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>sizes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>size_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>size_value</B></TD><TD ALIGN="LEFT">NUMERIC(4,1)</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">UQ</FONT></TD></TR></TABLE>>];
stock_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>stock_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>stock_item_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>size_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">INTEGER</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>quantity_available</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>order_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>order_date</B></TD><TD ALIGN="LEFT">DATE</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>user_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">INTEGER</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">FK</FONT></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#70B2AF"><TR><TD COLSPAN="3" BGCOLOR="#D2F6E7" ALIGN="LEFT"><FONT POINT-SIZE="15"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>order_item_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">SERIAL</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>order_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>stock_item_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">INTEGER</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>quantity</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="CENTER"><FONT COLOR="#3E827E">-</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F2FAF7"><B>price</B></TD><TD ALIGN="LEFT" BGCOLOR="#F2FAF7">NUMERIC(12,2)</TD><TD ALIGN="CENTER" BGCOLOR="#F2FAF7"><FONT COLOR="#3E827E">-</FONT></TD></TR></TABLE>>];
users -> roles [label="role_id", arrowhead=vee];
products -> categories [label="category_id", arrowhead=vee];
products -> manufacturers [label="manufacturer_id", arrowhead=vee];
stock_items -> products [label="product_id", arrowhead=vee];
stock_items -> sizes [label="size_id", arrowhead=vee];
orders -> users [label="user_id", arrowhead=vee];
order_items -> orders [label="order_id", arrowhead=vee];
order_items -> stock_items [label="stock_item_id", arrowhead=vee];
}
